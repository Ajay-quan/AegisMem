# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_SUPERUSER_PASSWORD=
AEGIS_OWNER_PASSWORD=
AEGIS_APP_PASSWORD=
APP_SECRET_KEY=
API_KEY_PEPPER=

# Embeddings: any OpenAI-compatible API. Dimension must match the model.
#   OpenAI:  https://api.openai.com/v1  text-embedding-3-small  1536
#   Ollama:  http://host.docker.internal:11434/v1  nomic-embed-text  768
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=

API_PORT=8000
