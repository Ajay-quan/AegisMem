# stateful.ai Environment Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO

# Storage backend. "memory" (default) runs the whole service with NO external
# infrastructure; the production values use the external services below.
# Unreachable configured store: development/staging fall back to in-memory with
# a warning; production (APP_ENV=production) RAISES instead of silently
# downgrading to a non-durable store.
RELATIONAL_STORE=memory     # memory | postgres
VECTOR_STORE=memory         # memory | qdrant
GRAPH_STORE=memory          # memory | neo4j
DATA_DIR=./data/stateful_ai

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stateful_ai
POSTGRES_USER=stateful_ai
POSTGRES_PASSWORD=stateful_ai_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=stateful_ai_memories

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=stateful_ai_password

# LLM Providers (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding backend. "mock" = zero-dependency deterministic vectors (no model
# download, used by the zero-infra default and tests); "sentence_transformers"
# = real local embeddings (needs the [embeddings] extra); "openai" = OpenAI
# embeddings API (needs the [llm] extra + OPENAI_API_KEY).
EMBEDDING_BACKEND=mock
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Default LLM provider: openai | anthropic | local | mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=gpt-4o-mini

# Memory settings
MEMORY_IMPORTANCE_THRESHOLD=0.3
MEMORY_MAX_WORKING_TOKENS=4096
REFLECTION_TRIGGER_COUNT=10

# Hybrid retrieval (dense semantic + sparse BM25 fused with Reciprocal Rank Fusion)
HYBRID_RETRIEVAL_ENABLED=true
RRF_K=60
WEIGHT_SEMANTIC=0.35
WEIGHT_LEXICAL=0.15
WEIGHT_RECENCY=0.20
WEIGHT_IMPORTANCE=0.20
WEIGHT_ACCESS=0.10

# Reranker: heuristic (default, no deps) | cross_encoder (needs [embeddings])
RERANKER_TYPE=heuristic
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Continual learning (Stateful-CL) -----------------------------------------
# Off by default: retrieval uses the static WEIGHT_* values above and nothing is
# logged or learned. When true, /retrieve returns a query_id and uses learned
# per-namespace ranking weights, and /feedback drives online policy updates.
CONTINUAL_LEARNING_ENABLED=false
CL_LEARNING_RATE=0.05
CL_EWC_LAMBDA=0.1
CL_REPLAY_CAPACITY=5000
CL_REPLAY_PERSIST=false
CL_REWARD_SUCCESS_BONUS=0.2
CL_REWARD_CONTRADICTION_PENALTY=0.3

# --- Privacy ---------------------------------------------------------------
# Redact PII (emails, phones, cards [Luhn-checked], SSNs, IPs, secrets) at the
# ingest boundary so sensitive tokens are never embedded, stored, or retrieved.
PII_REDACTION_ENABLED=false

# --- Multi-tenant API keys (optional, revocable, scoped) -------------------
# Comma- or newline-separated "name:secret" or "name:secret:tenant". Works
# alongside STATEFUL_AI_API_KEY (which maps to name "default"). Each mutating API
# call is attributed to its key in the audit log (GET /api/v1/audit).
# STATEFUL_AI_API_KEYS=web-app:sk_live_xxx:acme,analytics:sk_live_yyy:acme
