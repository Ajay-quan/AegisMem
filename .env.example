# AegisMem configuration. Copy to .env. Every key maps to core/config/settings.py.
# Development needs none of the infrastructure below (in-memory defaults).

# --- Application ---------------------------------------------------------------
APP_ENV=development                # development | staging | production
APP_SECRET_KEY=                    # 48+ random chars in staging/production (receipts, feature hashing)
API_KEY_PEPPER=                    # 48+ random chars, distinct from APP_SECRET_KEY (API-key hashing)
AUTH_ENABLED=false                 # must be true in staging/production
LOG_LEVEL=INFO

# --- Storage topology ------------------------------------------------------------
# Development defaults to in-memory stores. Staging/production must use real stores and
# refuse to start otherwise. Single-store mode: MEMORY_BACKEND=postgres VECTOR_BACKEND=pgvector GRAPH_BACKEND=none
MEMORY_BACKEND=memory              # memory | postgres
VECTOR_BACKEND=memory              # memory | pgvector | qdrant
GRAPH_BACKEND=memory               # memory | neo4j | none
CONTROL_DATABASE_URL=              # empty: SQLite file in development, Postgres in staging/production

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegismem
POSTGRES_USER=aegis_app            # NOSUPERUSER NOBYPASSRLS in production (RLS is enforced)
POSTGRES_PASSWORD=
REQUIRE_RLS=true

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aegismem_memories
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (any OpenAI-compatible API; mock is development-only) ------------
EMBEDDING_BACKEND=mock             # mock | openai | sentence_transformers
EMBEDDING_API_BASE=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
EMBEDDING_MODEL=text-embedding-3-small         # Ollama: nomic-embed-text
EMBEDDING_DIMENSION=1536                       # must match the model (nomic-embed-text: 768)
EMBEDDING_API_KEY=

# --- Retrieval -----------------------------------------------------------------------
HYBRID_RETRIEVAL_ENABLED=true      # dense + BM25 fused with RRF
HYBRID_LEXICAL_WEIGHT=0.15         # tuned on LoCoMo (bench/RESULTS.md)
LEXICAL_CANDIDATE_POOL=2000
RERANKER_TYPE=heuristic            # heuristic | cross_encoder

# --- Privacy, limits, operations ----------------------------------------------------
PII_REDACTION_ENABLED=false
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_BACKEND=memory          # off | memory | redis (redis required with >1 replica)
METRICS_ENABLED=true
OTEL_ENABLED=false
OUTBOX_WORKER_ENABLED=true

# --- LLM providers (reflection, contradiction and update judgements) --------------------
DEFAULT_LLM_PROVIDER=local         # openai | anthropic | local (Ollama) | mock
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
