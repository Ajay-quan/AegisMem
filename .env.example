# AegisMem Environment Configuration
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO

# Storage backend. "memory" (default) runs the whole service with NO external
# infrastructure; "postgres" uses the SQL store below (needs the [postgres]
# extra). If postgres is selected but unreachable, it falls back to in-memory.
RELATIONAL_STORE=memory
DATA_DIR=./data/aegismem

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegismem
POSTGRES_USER=aegismem
POSTGRES_PASSWORD=aegismem_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=aegismem_memories

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aegismem_password

# LLM Providers (set at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding model. Use "mock" for a zero-dependency deterministic backend
# (no model download); "sentence_transformers" for real local embeddings
# (needs the [embeddings] extra); "openai" to use the OpenAI embeddings API.
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_BACKEND=mock

# Default LLM provider: openai | anthropic | local | mock
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=gpt-4o-mini

# Memory settings
MEMORY_IMPORTANCE_THRESHOLD=0.3
MEMORY_MAX_WORKING_TOKENS=4096
REFLECTION_TRIGGER_COUNT=10

# Hybrid retrieval (dense semantic + sparse BM25 fused with Reciprocal Rank Fusion)
HYBRID_RETRIEVAL_ENABLED=true
RRF_K=60
WEIGHT_SEMANTIC=0.35
WEIGHT_LEXICAL=0.15
WEIGHT_RECENCY=0.20
WEIGHT_IMPORTANCE=0.20
WEIGHT_ACCESS=0.10

# Reranker: heuristic (default, no deps) | cross_encoder (needs [embeddings])
RERANKER_TYPE=heuristic
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
