        </mxCell>
        <mxCell id="ebs" value="EC2 t2.micro / t3.micro&#xa;8 GB gp3 EBS volume&#xa;/opt/aegismem/data mounted into container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="api" target="svc" style="endArrow=block;html=1;">
